# ============================================================
# Wasstraat Archeologische Data — instellingen van de live installatie
# ============================================================
# docker-compose.yml leest dit bestand als het .env heet ('make init' kopieert het).
# Mappen zijn relatief aan deze map, of absoluut.

# Versie van de images op ghcr.io/brienen (de tag). Bijwerken: nieuwe versie invullen en 'make update'.
WASSTRAAT_VERSION=1.1.0
# Registry waar de images vandaan komen; alleen wijzigen als je een eigen kopie van de images gebruikt
#WASSTRAAT_REGISTRY=ghcr.io/brienen

# Gemeenteprofiel voor de pipeline: delft of voorbeeld
WASSTRAAT_GEMEENTE=delft

# Mappen op de host
WASSTRAAT_INPUT=./data/input
WASSTRAAT_OUTPUT=./data/output
WASSTRAAT_BACKUP=./data/backup
WASSTRAAT_CONFIG=./wasstraat_config

# Hostpoorten van Airflow en van de Wasstraat-webapplicatie. Apache is de voordeur van de
# webapplicatie: het serveert de media onder /archeomedia en stuurt al het overige door
# naar Flask, dat zelf geen hostpoort heeft.
WASSTRAAT_PORT_AIRFLOW=8080
WASSTRAAT_PORT_APACHE=5052
# Netwerkadres waarop de webapplicaties luisteren: 0.0.0.0 = alle netwerkkaarten, 127.0.0.1 = alleen deze machine
WASSTRAAT_BIND=0.0.0.0

# Databases: standaard alleen bereikbaar vanaf deze machine (bijvoorbeeld QGIS of pgAdmin op dezelfde server)
WASSTRAAT_PORT_POSTGRES=5432
WASSTRAAT_PORT_MONGO=27017
WASSTRAAT_BIND_DB=127.0.0.1

# Geheugen voor Elasticsearch (Java heap). 512m volstaat voor enkele honderden projecten.
WASSTRAAT_ES_GEHEUGEN=512m

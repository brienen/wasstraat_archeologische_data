# Airflow metadata database (moet overeenkomen met postgres.env)
DB__HOST=wasstraat_postgres
DB__PORT=5432
DB__USERNAME=airflow
DB__PASSWORD=airflow_secret_42
DB__NAME=airflow

PGPASSWORD=${DB__PASSWORD}
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN="postgresql+psycopg2://${DB__USERNAME}:${DB__PASSWORD}@${DB__HOST}:${DB__PORT}/${DB__NAME}"

# Airflow configuratie
# -- CORE
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
# -- WEBSERVER
# Adres waaronder de webinterface van Airflow bereikbaar is; Airflow gebruikt het voor de links
# in logs en meldingen. Airflow staat niet achter Apache: pas host en poort aan als Airflow via
# een andere naam of poort bereikbaar is (live installatie: WASSTRAAT_PORT_AIRFLOW).
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080
AIRFLOW__WEBSERVER__WEB_SERVER_HOST=0.0.0.0
# -- SCHEDULER
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=60
# -- ADMIN
SECURITY__ADMIN_USERNAME=admin
SECURITY__ADMIN_FIRSTNAME=Admin
SECURITY__ADMIN_LASTNAME=Administrators
SECURITY__ADMIN_EMAIL=admin@example.com
SECURITY__ADMIN_PASSWORD=admin

# Werkmap, logmap en harmonisatie-Excel van de pipeline (paden in de container; leeg of
# weggelaten: dezelfde standaardwaarden)
AIRFLOW_TEMPDIR=/opt/airflow/tmp
AIRFLOW_LOGDIR=/opt/airflow/logs
AIRFLOW_WASSTRAAT_CONFIG=/opt/airflow/config/Wasstraat_Config_HarmonizeV3.xlsx

# Extractie van afbeeldingen en rapporten: de taak Controleer_Afbeeldingen laat de DAG falen als
# meer bestanden mislukken dan het grootste van AIRFLOW_MAX_MISLUKTE_AFBEELDINGEN (aantal) en
# AIRFLOW_MAX_MISLUKTE_AFBEELDINGEN_PCT (procent van het aantal bestanden); daaronder volgt een
# waarschuwing in het log. Een vol mediavolume laat de import altijd direct falen. Leeg of
# weggelaten: 10 bestanden en 1 procent. Zie docs/componenten/extractie.md.
AIRFLOW_MAX_MISLUKTE_AFBEELDINGEN=10
AIRFLOW_MAX_MISLUKTE_AFBEELDINGEN_PCT=1

# Foutbeleid (issue 54): een fout in één bestand, tabel of record is een waarschuwing in het
# run-document en het verwerkingsrapport; boven deze drempels stopt de run toch. Drempel =
# het grootste van het aantal en het percentage. Onleesbare Access-databases (taak
# Controleer_Databases) en records die Transform 2 niet kon verwerken (_processing_errors).
# Leeg of weggelaten: 2 databases en 5 procent, 100 records en 1 procent.
AIRFLOW_MAX_MISLUKTE_DATABASES=2
AIRFLOW_MAX_MISLUKTE_DATABASES_PCT=5
AIRFLOW_MAX_VERWERKINGSFOUTEN=100
AIRFLOW_MAX_VERWERKINGSFOUTEN_PCT=1

# Verwerkingsrapport per run, als JSON en Markdown (issue 62). Niet schrijfbaar: de taak
# Verwerkingsrapport schrijft in AIRFLOW_LOGDIR/rapporten. Zie docs/componenten/verwerkingsrapport.md.
AIRFLOW_OUTPUT_RAPPORTEN=/output/rapporten
